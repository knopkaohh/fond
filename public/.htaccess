# Статический сайт для https://bm-develop.ru/fond/
DirectoryIndex index.html
ErrorDocument 404 /fond/404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /fond/

# Адрес страницы без завершающего слэша ведёт на каталог с index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/ [R=301,L]
</IfModule>
